// Public hosting on Cloudflare Workers (free plan). Oxygen only offers private
// URLs on a development store, so the same production build runs here too.
// Deploy with `node scripts/deploy-cloudflare.mjs` (reads .env; see README).
{
  "name": "sunfizz",
  // The Hydrogen server build is already a self-contained Workers module.
  "main": "dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2025-04-01", // same as dist/server/oxygen.json
  // Built client files (JS, CSS, fonts, /fx SVGs) are served before the worker runs.
  "assets": {
    "directory": "dist/client"
  },
  "observability": {
    "enabled": true
  }
}
